{
  "name": "flightnudge",
  "version": "1.0.0",
  "description": "FlightNudge: flight-sized Google Calendar reminders for the flights Gmail adds",
  "main": "dist/Code.js",
  "scripts": {
    "build": "tsc",
    "test": "jest",
    "test:watch": "jest --watch",
